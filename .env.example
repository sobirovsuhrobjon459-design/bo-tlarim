# Bu fayl NAMUNA uchun. Haqiqiy maxfiy qiymatlar faqat ".env" faylida bo'lishi kerak
# (".env" gitga hech qachon qo'shilmaydi, buni .gitignore ta'minlaydi).
#
# Render'da (yoki boshqa xostingda) bu qiymatlar "Environment Variables"
# bo'limida qo'lda kiritiladi — .env fayli u yerga yuklanmaydi.

# ========== Majburiy ==========

# BotFather'dan olingan bot tokeni
BOT_TOKEN=your_bot_token_here

# Mini App ochiladigan ommaviy (public) HTTPS manzil.
# Lokal kompyuterda sinash uchun ngrok/cloudflared kabi tunnel xizmatidan foydalaniladi.
WEBAPP_URL=https://your-public-url.example.com

# Ma'lumotlar bazasi manzili.
#
# MUHIM: productionda bu albatta PostgreSQL bo'lishi kerak. Render'ning bepul
# tarifida fayl tizimi vaqtinchalik — SQLite bilan ishlasa, har deploydan keyin
# o'qituvchi akkauntlari ham, testlar ham o'chib ketadi.
DATABASE_URL=sqlite:///./backend/app.db

# ========== Admin ==========

# Admin bo'limini ko'radigan Telegram foydalanuvchi ID'si.
# Bo'sh bo'lsa: admin paneli, kunlik zaxira nusxa va pul yechish
# bildirishnomalari ishlamaydi.
ADMIN_ID=

# O'qituvchilar kredit sotib olganda pul o'tkazadigan karta raqami.
# Bir nechta karta bo'lsa — nuqtali vergul bilan: 8600 1234 5678 9012; 9860 1234 5678 9012
ADMIN_CARD_NUMBER=

# ========== To'lovlar (Payme) ==========

# Payme Business kabinetidan olinadi: https://business.payme.uz
#
# MUHIM: ikkalasi ham to'ldirilishi kerak. PAYME_MERCHANT_ID bo'sh bo'lsa,
# pullik test va kredit sotib olish o'chirilgan holatda qoladi (bu xavfsiz).
# PAYME_SECRET_KEY esa webhook'ning imzosini tekshiradi — u bo'sh bo'lsa,
# server hech qanday "to'lov bo'ldi" xabarini qabul qilmaydi.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
# Sinov rejimi (test.paycom.uz, haqiqiy pulsiz). Sinovdan keyin olib tashlang.
PAYME_TEST_MODE=

# --- Click (my.click.uz) — avtomatik to'lov: Uzcard, Humo, Visa, Mastercard ---
# Click biznes kabinetida "Prepare URL" va "Complete URL" quyidagicha bo'ladi:
#   https://<sizning-manzil>/api/click/prepare
#   https://<sizning-manzil>/api/click/complete
# Uchalasi ham to'ldirilsa, "Click orqali to'lash" tugmasi paydo bo'ladi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Pullik testda platforma ushlab qoladigan foiz (qolgani o'qituvchiga boradi)
PLATFORM_COMMISSION_PERCENT=20

# Yangi o'qituvchi ro'yxatdan o'tganda beriladigan sovg'a kreditlar.
# Har bir bepul test natijasi uchun 1 kredit sarflanadi.
WELCOME_CREDITS=8000

# ========== Faqat lokal sinov uchun ==========

# 1 bo'lsa, Telegram'siz (oddiy brauzerda) ham sinash mumkin bo'ladi.
#
# DIQQAT: bu rejimda "X-Dev-User" header'i Telegram imzosini butunlay
# almashtiradi — ya'ni istalgan odam istalgan foydalanuvchi, hatto admin
# bo'lib kirishi mumkin. Shuning uchun u faqat SQLite bazasi bilan
# ishlaganda yoqiladi; PostgreSQL bo'lsa, 1 qo'yilgan bo'lsa ham o'zi o'chadi.
DEV_MODE=0

# ========== Ommaviy oferta (/oferta sahifasi) — YaTT rekvizitlari ==========
LEGAL_NAME=
LEGAL_INN=
LEGAL_PHONE=
LEGAL_EMAIL=
LEGAL_ADDRESS=
LEGAL_BOT=
