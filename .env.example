# Bu fayl NAMUNA uchun. Haqiqiy maxfiy qiymatlar faqat ".env" faylida bo'lishi kerak
# (".env" gitga hech qachon qo'shilmaydi, buni .gitignore ta'minlaydi).

# BotFather'dan olingan bot tokeni
BOT_TOKEN=your_bot_token_here

# Mini App ochiladigan ommaviy (public) HTTPS manzil.
# Lokal kompyuterda sinash uchun ngrok/cloudflared kabi tunnel xizmatidan foydalaniladi.
WEBAPP_URL=https://your-public-url.example.com

# Ma'lumotlar bazasi manzili. Hozircha SQLite (fayl asosida), keyinchalik PostgreSQL'ga o'tkaziladi.
DATABASE_URL=sqlite:///./backend/app.db

# 1 bo'lsa, Telegram'siz (oddiy brauzerda) ham sinash mumkin bo'ladi. Productionda 0 bo'lishi kerak.
DEV_MODE=0

# Admin bo'limini ko'radigan Telegram foydalanuvchi ID'si
ADMIN_ID=

# Pullik testda platforma ushlab qoladigan foiz (qolgani o'qituvchiga boradi)
PLATFORM_COMMISSION_PERCENT=30

# O'qituvchilarga pul balansini to'ldirish uchun ko'rsatiladigan karta raqami
ADMIN_CARD_NUMBER=

# Payme Business kabinetidan olinadi (https://business.payme.uz) — kredit sotib olish uchun
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
